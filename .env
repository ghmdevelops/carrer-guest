# URL publica do site, usada nas meta tags de compartilhamento e no JSON-LD.
# Precisa ser absoluta: crawlers de rede social nao resolvem caminho relativo.
#
# Na Netlify este valor e sobrescrito automaticamente pelo netlify.toml, que
# injeta a URL real do deploy. Troque abaixo apenas se publicar em outro lugar.
VITE_SITE_URL=https://career-quest.netlify.app
